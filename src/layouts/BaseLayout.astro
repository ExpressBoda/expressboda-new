---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/utils';
import '../styles/global.css'; // <--- ВОТ ЭТА СТРОКА ОБЯЗАТЕЛЬНА ДЛЯ TAILWIND

interface Props {
  title: string;
  description: string;
  lang: Lang;
  noindex?: boolean;
  alternateLanguages?: Lang[];
}

const { title, description, lang, noindex, alternateLanguages } = Astro.props;

// Автоматически берем текущий путь из URL (например, /en/documents)
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} lang={lang} noindex={noindex} alternateLanguages={alternateLanguages} />
    
    <!-- Иконки сайта -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    
  </head>
  <body class="min-h-screen flex flex-col font-sans text-gray-900 bg-white">
    <!-- Передаем и язык, и текущий путь в шапку -->
    <Header lang={lang} currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

  </body>
</html>
