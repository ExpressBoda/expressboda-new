---
// src/pages/en/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Fast & Legal Marriage in Denmark for International Couples | Express Boda">
  
  <!-- 1. First Screen (Hero Section) -->
  <section class="hero">
    <h1>Fast & Legal Marriage in Denmark for International Couples</h1>
    <h2>Complete administrative support, paperwork assistance, and fast-track wedding registration in scenic Danish municipalities. Zero bureaucracy, stress-free process.</h2>
    <div class="cta-group">
      <a href="/en/services/" class="btn-primary">View Services & Pricing</a>
      <a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="btn-secondary">Free WhatsApp Consultation</a>
    </div>
  </section>

  <!-- 2. Trust & Benefits -->
  <section class="benefits">
    <h2>Why International Couples Choose Express Boda</h2>
    <div class="grid">
      <div class="card">
        <h3>Fast-Track Processing</h3>
        <p>Get your marriage approved and scheduled in days, not months, with our streamlined approach.</p>
      </div>
      <div class="card">
        <h3>Full Administrative Support</h3>
        <p>We handle all interactions with Familieretshuset and municipal offices on your behalf.</p>
      </div>
      <div class="card">
        <h3>Global Recognition</h3>
        <p>Receive an internationally valid marriage certificate recognized in the EU, Spain, and worldwide.</p>
      </div>
    </div>
  </section>

  <!-- 3. Core Services Overview -->
  <section class="services-overview">
    <h2>Our Core Services</h2>
    <div class="services-grid">
      <div class="service-card">
        <h3>Standard Wedding in Denmark</h3>
        <p>Complete paperwork and registration support for international couples.</p>
      </div>
      <div class="service-card">
        <h3>Same-Sex Weddings</h3>
        <p>Specialized legal and administrative assistance for equal marriage registration.</p>
      </div>
      <div class="service-card">
        <h3>Apostille & Legalization</h3>
        <p>Official document legalization for use in your home country or Spain.</p>
      </div>
      <div class="service-card">
        <h3>Duplicate Certificates</h3>
        <p>Fast replacement ordering for lost or missing marriage certificates.</p>
      </div>
    </div>
  </section>

  <!-- 4. FAQ Section for SEO -->
  <section class="faq">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>Is a Danish marriage recognized internationally?</h3>
      <p>Yes. Marriage certificates issued in Denmark are fully legal and recognized worldwide, especially when accompanied by an Apostille.</p>
    </div>
    <div class="faq-item">
      <h3>Do we need to travel to Denmark for a long time?</h3>
      <p>No, the actual ceremony takes only a short time, and many couples travel just for 1-2 days.</p>
    </div>
  </section>

</Layout>

<style>
  .hero { text-align: center; padding: 4rem 1rem; max-width: 800px; margin: 0 auto; }
  .hero h1 { font-size: 2.5rem; margin-bottom: 1rem; line-height: 1.2; }
  .hero h2 { font-size: 1.2rem; color: #555; margin-bottom: 2rem; font-weight: normal; }
  .cta-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: #2563eb; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600; }
  .btn-secondary { background: #e5e7eb; color: #1f2937; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600; }
  
  section { margin: 4rem 0; }
  section h2 { text-align: center; margin-bottom: 2rem; font-size: 2rem; }
  
  .grid, .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
  .card, .service-card { background: #f9fafb; padding: 1.5rem; border-radius: 8px; border: 1px solid #e5e7eb; }
  
  .faq-item { margin-bottom: 1.5rem; background: #f9fafb; padding: 1.25rem; border-radius: 8px; }
  .faq-item h3 { margin-bottom: 0.5rem; font-size: 1.1rem; }
</style>