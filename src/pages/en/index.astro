---
import Layout from '../../layouts/BaseLayout.astro';
import Quiz from '../../components/Quiz.astro';
import WhatYouNeed from '../../components/WhatYouNeed.astro';
import content from '../../data/en.json';

const lang = 'en';
---

<Layout 
  title="Fast & Legal Marriage in Denmark for International Couples | Express Boda"
  description="Direct application to the Danish Agency of Family Law (AFL). Guaranteed correct document preparation, full support at every step, and fast legalization."
  lang={lang}
>

  <!-- 1. HERO SECTION WITH QUIZ -->
  <section class="bg-gradient-to-b from-slate-100 to-[#FAFAFC] pt-14 pb-10 px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid md:grid-cols-12 gap-12 items-center">
      
      <div class="md:col-span-7 space-y-6 text-center md:text-left flex flex-col items-center md:items-start">
        
        <!-- Trustpilot Widget -->
        <div class="flex justify-center md:justify-start">
          <div class="inline-block px-3 py-2 bg-white rounded-xl shadow-sm border border-slate-200 transition hover:shadow-md overflow-hidden">
            <div class="trustpilot-widget" 
                 data-locale="en-US" 
                 data-template-id="5419b6a8b0d04a076446a9ad" 
                 data-businessunit-id="64706bc1a10721677e3d43e9" 
                 data-style-height="40px" 
                 data-style-width="220px" 
                 data-theme="light" 
                 data-min-review-count="10" 
                 data-style-alignment="left">
              <a href="https://www.trustpilot.com/review/expressboda.com" target="_blank" rel="noopener">Trustpilot</a>
            </div>
            <script async src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" charset="utf-8"></script>
          </div>
        </div>

        <h1 class="font-serif text-4xl lg:text-5xl font-bold leading-tight text-slate-900">
          {content.hero.title}
        </h1>

        <p class="text-slate-600 text-base leading-relaxed max-w-xl md:max-w-none">
          {content.hero.subtitle}
        </p>

        <!-- Perks list: clean vertical alignment with left-aligned text on mobile -->
        <div class="flex flex-col gap-3 pt-1 text-sm text-slate-700 font-medium items-start w-full max-w-md md:max-w-none">
          {content.hero.perks.map((perk) => (
            <div class="flex items-start gap-2.5 text-left w-full">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span>
              <span>{perk}</span>
            </div>
          ))}
        </div>

        <!-- CTA Button: Full width on mobile and tablets, original auto width on desktop -->
        <div class="pt-2 flex flex-col items-center md:items-start gap-4 w-full max-w-md md:max-w-none">
          <a href="#services" class="w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-xl transition shadow-md text-center block text-base">
            {content.hero.secondary_cta}
          </a>
          <span class="text-xs text-slate-500 text-center md:text-left">
            ⚡ Or take a 1-min case check via the quiz on the right
          </span>
        </div>
      </div>

      <div id="checker" class="md:col-span-5 bg-white p-6 rounded-2xl shadow-xl border border-slate-200">
        <Quiz />
      </div>
    </div>
  </section>

  <!-- 1.1 HERO BOTTOM TRUST BANNER -->
  <section class="bg-white text-slate-800 py-6 px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-center md:text-left">
      
      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg font-bold shrink-0">⭐</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item1.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item1.subtitle}</div>
        </div>
      </div>

      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg font-bold shrink-0">🛡️</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item2.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item2.subtitle}</div>
        </div>
      </div>

      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-bold shrink-0">⚡</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item3.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item3.subtitle}</div>
        </div>
      </div>

      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg font-bold shrink-0">💶</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item4.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item4.subtitle}</div>
        </div>
      </div>

    </div>
  </section>

  <!-- WHAT YOU NEED -->
  <WhatYouNeed />

  <section class="py-16 px-6 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">Why International Couples Choose ExpressBoda for their marriage in Denmark</h2>
      <p class="text-slate-600">Compare DIY application risks with professional agency handling</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      
      <!-- DIY Application -->
      <div class="bg-red-50/50 border border-red-100 p-8 rounded-2xl">
        <h3 class="text-red-700 font-bold text-lg mb-4 flex items-center gap-2">❌ DIY Application</h3>
        <ul class="space-y-3 text-slate-700 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-red-500 font-bold mt-0.5">•</span>
            <span><strong>Uncertainty of requirements:</strong> Couples often don't know which exact documents apply to their specific case.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 font-bold mt-0.5">•</span>
            <span><strong>Preparation errors:</strong> Mistakes in formatting or preparing paperwork lead to immediate rejections.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 font-bold mt-0.5">•</span>
            <span><strong>Process complexity:</strong> Unfamiliarity with bureaucratic nuances causes unexpected delays.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 font-bold mt-0.5">•</span>
            <span><strong>Language barrier:</strong> Official submissions and correspondence must be handled entirely in English or Danish.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 font-bold mt-0.5">•</span>
            <span><strong>Lengthy delays:</strong> Mistakes can cause applications to stall for up to 3 months instead of 5 days.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-500 font-bold mt-0.5">•</span>
            <span><strong>Wrong municipality choice:</strong> Selecting the wrong registry office can block marriage dates entirely.</span>
          </li>
        </ul>
      </div>

      <!-- Through ExpressBoda -->
      <div class="bg-emerald-50/50 border border-emerald-100 p-8 rounded-2xl">
        <h3 class="text-emerald-700 font-bold text-lg mb-4 flex items-center gap-2">✅ Through ExpressBoda</h3>
        <ul class="space-y-3 text-slate-700 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span><strong>Full document expertise:</strong> We know all precise requirements for your unique background and nationality.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span><strong>Zero-error preparation:</strong> Every document is thoroughly audited before submission to ensure smooth approval.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span><strong>Guaranteed dates & locations:</strong> We help you choose a registry office that has exact dates matching your schedule.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span><strong>Full communication handling:</strong> We take care of all correspondence with government bodies and registry offices.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span><strong>Extra services included:</strong> Additional services like Apostille legalization are smoothly organized upfront.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span><strong>Transparent pricing:</strong> Clear, upfront service costs with zero hidden fees.</span>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- REVIEWS SECTION -->
  <section class="bg-slate-50 py-16 px-6 border-t border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-1 text-amber-500 mb-2 text-lg">
          ★★★★★
        </div>
        <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">Trusted by Couples Worldwide</h2>
        <p class="text-slate-600">
          Read verified experiences from couples who got married smoothly through ExpressBoda. 
          <a href="https://www.trustpilot.com/review/expressboda.com" target="_blank" rel="noopener" class="text-blue-600 underline font-medium hover:text-blue-700">See all reviews on Trustpilot</a>
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        
        <!-- Review 1 -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-1 font-bold">★★★★★</div>
            <div class="text-xs text-emerald-600 font-semibold mb-3">✓ Verified Trustpilot Review</div>
            <h4 class="font-bold text-slate-900 text-base mb-2">Excellent Experience</h4>
            <p class="text-slate-700 text-sm italic mb-6">
              "Fran was exceptional and organized everything smoothly. He kept us informed daily, ensuring all papers were in perfect order. Highly professional and trustworthy. Thank you, Fran!"
            </p>
          </div>
          <div class="border-t border-slate-100 pt-4 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Victoriya & Endru</span>
            <span class="text-slate-400">Mar 8, 2025</span>
          </div>
        </div>

        <!-- Review 2 -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-1 font-bold">★★★★★</div>
            <div class="text-xs text-emerald-600 font-semibold mb-3">✓ Verified Trustpilot Review</div>
            <h4 class="font-bold text-slate-900 text-base mb-2">Professional service</h4>
            <p class="text-slate-700 text-sm italic mb-6">
              "We wanted to get married in Denmark on short notice. From first contact to our wedding day just 3 weeks later, everything went smoothly with clear instructions and great support."
            </p>
          </div>
          <div class="border-t border-slate-100 pt-4 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Verified Couple</span>
            <span class="text-slate-400">Nov 29, 2025</span>
          </div>
        </div>

        <!-- Review 3 -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-1 font-bold">★★★★★</div>
            <div class="text-xs text-emerald-600 font-semibold mb-3">✓ Verified Trustpilot Review</div>
            <h4 class="font-bold text-slate-900 text-base mb-2">Finally married 🥰</h4>
            <p class="text-slate-700 text-sm italic mb-6">
              "Constant communication, transparent support, and very quick process once dates were chosen. We are so happy and finally married! Many thanks to Express Boda and coordinator Fran."
            </p>
          </div>
          <div class="border-t border-slate-100 pt-4 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Verified Couple</span>
            <span class="text-slate-400">May 7, 2026</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PRICING SECTION -->
  <section id="services" class="bg-slate-50 py-16 px-6 border-t border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">Transparent Pricing Packages</h2>
        <p class="text-slate-600">Choose the level of support that fits your timeline and preferences.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 items-stretch">
        
        <!-- 1. Consultation & Roadmap (DIY) -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">DIY Support</div>
            <h3 class="font-bold text-2xl text-slate-900 mb-1">Consultation & Roadmap</h3>
            <div class="text-3xl font-extrabold text-slate-900 mb-6">€250</div>
            <p class="text-slate-500 text-sm mb-6">For couples who want to handle the application themselves with expert guidance.</p>
            <ul class="space-y-3 text-sm text-slate-700 mb-8">
              <li class="flex items-start gap-2"><span>✓</span> <strong>60-min phone consultation</strong> at your convenience</li>
              <li class="flex items-start gap-2"><span>✓</span> Case review & success rate assessment</li>
              <li class="flex items-start gap-2"><span>✓</span> Detailed checklist & document prep guide</li>
              <li class="flex items-start gap-2"><span>✓</span> Instructions on submission & office selection</li>
              <li class="flex items-start gap-2"><span>✓</span> Guidance on getting the Apostille</li>
            </ul>
          </div>
          <a href="/en/services/consultation" class="block text-center w-full md:w-auto bg-slate-900 hover:bg-slate-800 text-white py-4 rounded-xl font-semibold transition shadow-sm text-base">
            Explore package
          </a>
        </div>

        <!-- 2. Classic Package (Standard) -->
        <div class="bg-white p-8 rounded-2xl shadow-md border-2 border-blue-600 flex flex-col justify-between relative">
          <div class="absolute -top-3 right-6 bg-blue-600 text-white text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider">Most Popular</div>
          <div>
            <div class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">Standard Package</div>
            <h3 class="font-bold text-2xl text-slate-900 mb-1">Classic Marriage</h3>
            <div class="text-3xl font-extrabold text-slate-900 mb-2">€595</div>
            <div class="text-xs text-slate-400 mb-6">+ 2,100 DKK (~€285) state fee</div>
            <p class="text-slate-500 text-sm mb-6">End-to-end agency support for a smooth, standard-pace wedding process.</p>
            <ul class="space-y-3 text-sm text-slate-700 mb-8">
              <li class="flex items-start gap-2"><span>✓</span> <strong>Full consultation & case assessment</strong></li>
              <li class="flex items-start gap-2"><span>✓</span> Individual checklist & preparation guide</li>
              <li class="flex items-start gap-2"><span>✓</span> <strong>Personal manager & full process control</strong></li>
              <li class="flex items-start gap-2"><span>✓</span> Registry office selection & booking</li>
              <li class="flex items-start gap-2"><span>✓</span> Date booking (~60-90 days after approval)</li>
            </ul>
          </div>
          <a href="/en/services/standard" class="block text-center w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-xl font-semibold transition shadow-md text-base">
            Explore package
          </a>
        </div>

        <!-- 3. Express VIP Package -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-amber-600 uppercase tracking-wider mb-1">Urgent & Fast-Track</div>
            <h3 class="font-bold text-2xl text-slate-900 mb-1">Express VIP</h3>
            <div class="text-3xl font-extrabold text-slate-900 mb-2">€1190</div>
            <div class="text-xs text-slate-400 mb-6">+ 2,100 DKK (~€285) state fee</div>
            <p class="text-slate-500 text-sm mb-6">Priority handling for couples who want to get married as fast as possible.</p>
            <ul class="space-y-3 text-sm text-slate-700 mb-8">
              <li class="flex items-start gap-2"><span>✓</span> <strong>Everything included in Classic Package</strong></li>
              <li class="flex items-start gap-2"><span>✓</span> <strong>Priority document processing</strong></li>
              <li class="flex items-start gap-2"><span>✓</span> Nearest available date (up to 45 days post-approval)</li>
              <li class="flex items-start gap-2"><span>✓</span> <strong>Apostille included</strong> with standard EU delivery</li>
            </ul>
          </div>
          <a href="/en/services/vip" class="block text-center w-full md:w-auto bg-slate-900 hover:bg-slate-800 text-white py-4 rounded-xl font-semibold transition shadow-sm text-base">
            Explore package
          </a>
        </div>

      </div>
    </div>
  </section>

  <section class="py-16 px-6 max-w-5xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">How Your Marriage in Denmark Works</h2>
      <p class="text-slate-600">A clear 4-step roadmap from start to your official certificate</p>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">01</div>
        <h4 class="font-bold text-slate-900 mb-1">Free Assessment</h4>
        <p class="text-xs text-slate-600">You send us your documents, we check compliance instantly.</p>
      </div>
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">02</div>
        <h4 class="font-bold text-slate-900 mb-1">AFL Submission</h4>
        <p class="text-xs text-slate-600">We file your application directly to the Danish Agency of Family Law.</p>
      </div>
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">03</div>
        <h4 class="font-bold text-slate-900 mb-1">Choose Date & Place</h4>
        <p class="text-xs text-slate-600">Select your preferred scenic Danish town and wedding date.</p>
      </div>
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">04</div>
        <h4 class="font-bold text-slate-900 mb-1">Say "I Do"</h4>
        <p class="text-xs text-slate-600">Travel for 1-2 days, have your ceremony, and get your certificate.</p>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="bg-slate-50 py-16 px-6 border-t border-slate-200">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-3xl font-bold text-slate-900 text-center mb-10">Frequently Asked Questions</h2>
      
      <div class="space-y-4">
        <details class="bg-white rounded-xl border border-slate-200 overflow-hidden group">
          <summary class="font-bold text-slate-900 p-6 cursor-pointer flex justify-between items-center select-none">
            Why is marriage in Denmark fast and easy for international couples?
            <span class="transition group-open:rotate-180 text-blue-600 font-normal">▼</span>
          </summary>
          <div class="px-6 pb-6 text-slate-600 text-sm space-y-2 border-t border-slate-100 pt-4">
            <p>The process is significantly <strong>faster</strong> than in many other countries. It is designed to be <strong>easy for international couples</strong> because fewer documents are required; usually, birth certificates or complex legalizations of IDs are not necessary.</p>
            <p>The Danish marriage certificate is internationally recognized, making it a reliable solution for family reunification and other legal processes worldwide.</p>
          </div>
        </details>

        <details class="bg-white rounded-xl border border-slate-200 overflow-hidden group">
          <summary class="font-bold text-slate-900 p-6 cursor-pointer flex justify-between items-center select-none">
            How long does it take to get a marriage license?
            <span class="transition group-open:rotate-180 text-blue-600 font-normal">▼</span>
          </summary>
          <div class="px-6 pb-6 text-slate-600 text-sm border-t border-slate-100 pt-4">
            <p>Our agency ensures a <strong>fast and easy</strong> application process. Once submitted, the <strong>Danish Agency of Family Law (AFL)</strong> typically reviews the application within 5–7 working days. We handle the paperwork to ensure there are no delays in your wedding schedule.</p>
          </div>
        </details>

        <details class="bg-white rounded-xl border border-slate-200 overflow-hidden group">
          <summary class="font-bold text-slate-900 p-6 cursor-pointer flex justify-between items-center select-none">
            Can non-EU citizens legally marry in Denmark?
            <span class="transition group-open:rotate-180 text-blue-600 font-normal">▼</span>
          </summary>
          <div class="px-6 pb-6 text-slate-600 text-sm border-t border-slate-100 pt-4">
            <p>Yes, absolutely. We specialize in making the process <strong>easy for binational and international couples</strong>. As long as you enter Denmark legally (e.g., with a Schengen visa or visa-free entry), we can help you obtain your marriage license and get married legally.</p>
          </div>
        </details>

        <details class="bg-white rounded-xl border border-slate-200 overflow-hidden group">
          <summary class="font-bold text-slate-900 p-6 cursor-pointer flex justify-between items-center select-none">
            Is the marriage certificate valid in Germany and worldwide?
            <span class="transition group-open:rotate-180 text-blue-600 font-normal">▼</span>
          </summary>
          <div class="px-6 pb-6 text-slate-600 text-sm border-t border-slate-100 pt-4">
            <p>Yes. After your ceremony, you receive an international marriage certificate. To make the process even more <strong>comprehensive and easy</strong>, we offer an <strong>Apostille service</strong>, ensuring your certificate is legally recognized for residency and official use in Germany and globally.</p>
          </div>
        </details>
      </div>

      <div class="text-center mt-10">
        <a href="/en/faq" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-xl transition shadow-md text-base">
          View all Frequently Asked Questions and Answers →
        </a>
      </div>
    </div>
  </section>

</Layout>