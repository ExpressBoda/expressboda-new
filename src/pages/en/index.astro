---
import Layout from '../../layouts/BaseLayout.astro';
import Quiz from '../../components/Quiz.astro';
import content from '../../data/en.json';

const lang = 'en';
---

<Layout 
  title="Fast & Legal Marriage in Denmark for International Couples | Express Boda"
  description="Direct application to the Danish Agency of Family Law (AFL). Guaranteed correct document preparation, full support at every step, and fast legalization."
  lang={lang}
>

  <!-- 1. HERO SECTION WITH QUIZ -->
  <section class="bg-gradient-to-b from-slate-100 to-[#FAFAFC] pt-14 pb-10 px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid md:grid-cols-12 gap-12 items-center">
      
      <div class="md:col-span-7 space-y-6">
        
        <!-- Trustpilot Widget - Выделенный блок -->
        <!-- Trustpilot Widget - Исправленный блок -->
        <div class="inline-block px-3 py-2 bg-white rounded-xl shadow-sm border border-slate-200 transition hover:shadow-md overflow-hidden">
          <div class="trustpilot-widget" 
               data-locale="en-US" 
               data-template-id="5419b6a8b0d04a076446a9ad" 
               data-businessunit-id="64706bc1a10721677e3d43e9" 
               data-style-height="40px" 
               data-style-width="220px" 
               data-theme="light" 
               data-min-review-count="10" 
               data-style-alignment="left">
            <a href="https://www.trustpilot.com/review/expressboda.com" target="_blank" rel="noopener">Trustpilot</a>
          </div>
          <script async src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" charset="utf-8"></script>
        </div>

        <h1 class="font-serif text-4xl lg:text-5xl font-bold leading-tight text-slate-900">
          {content.hero.title}
        </h1>

        <p class="text-slate-600 text-base leading-relaxed">
          {content.hero.subtitle}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1 text-sm text-slate-700 font-medium">
          {content.hero.perks.map((perk) => (
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xs font-bold shrink-0">✓</span>
              {perk}
            </div>
          ))}
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <a href="#services" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3.5 rounded-xl transition shadow-md">
            {content.hero.secondary_cta}
          </a>
          <span class="text-xs text-slate-500">
            ⚡ Or take a 1-min case check via the quiz on the right
          </span>
        </div>
      </div>

      <div id="checker" class="md:col-span-5 bg-white p-6 rounded-2xl shadow-xl border border-slate-200">
        <Quiz />
      </div>
    </div>
  </section>

  <!-- 1.1 HERO BOTTOM TRUST BANNER -->
  <section class="bg-white text-slate-800 py-6 px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-center md:text-left">
      
      <!-- Пункт 1: 100% 5-Star -->
      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg font-bold shrink-0">⭐</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item1.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item1.subtitle}</div>
        </div>
      </div>

      <!-- Пункт 2: High Approval -->
      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg font-bold shrink-0">🛡️</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item2.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item2.subtitle}</div>
        </div>
      </div>

      <!-- Пункт 3: Fast Wedding -->
      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-bold shrink-0">⚡</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item3.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item3.subtitle}</div>
        </div>
      </div>

      <!-- Пункт 4: From €495 -->
      <div class="flex items-center gap-4 justify-center md:justify-start">
        <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg font-bold shrink-0">💶</div>
        <div>
          <div class="font-bold text-base text-slate-900">{content.trust_banner.item4.title}</div>
          <div class="text-xs text-slate-500">{content.trust_banner.item4.subtitle}</div>
        </div>
      </div>

    </div>
  </section>

  <!-- (Остальная часть контента без изменений) -->
  
  <section class="py-16 px-6 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">Why International Couples Choose ExpressBoda</h2>
      <p class="text-slate-600">Compare DIY application risks with professional agency handling</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-red-50/50 border border-red-100 p-8 rounded-2xl">
        <h3 class="text-red-700 font-bold text-lg mb-4 flex items-center gap-2">❌ DIY Application</h3>
        <ul class="space-y-3 text-slate-700 text-sm">
          <li><strong>Risk of rejection:</strong> Small translation errors or missing paperwork can stall your case for months.</li>
          <li><strong>Loss of 2,300 DKK:</strong> The official AFL fee is non-refundable if your application is rejected.</li>
          <li><strong>Bureaucratic stress:</strong> Dealing with official Danish state correspondence alone.</li>
        </ul>
      </div>

      <div class="bg-emerald-50/50 border border-emerald-100 p-8 rounded-2xl">
        <h3 class="text-emerald-700 font-bold text-lg mb-4 flex items-center gap-2">✅ Through ExpressBoda</h3>
        <ul class="space-y-3 text-slate-700 text-sm">
          <li><strong>100% pre-audit:</strong> We thoroughly verify every scanned document before submission to AFL.</li>
          <li><strong>Time saved:</strong> Receive your marriage approval rapidly without revisions.</li>
          <li><strong>Full cycle:</strong> Assistance with translations, Ministry of Foreign Affairs, Apostille, and logistics.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- REVIEWS SECTION -->
  <section class="bg-slate-50 py-16 px-6 border-t border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-1 text-amber-500 mb-2 text-lg">
          ★★★★★
        </div>
        <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">Trusted by Couples Worldwide</h2>
        <p class="text-slate-600">
          Read verified experiences from couples who got married smoothly through ExpressBoda. 
          <a href="https://www.trustpilot.com/review/expressboda.com" target="_blank" rel="noopener" class="text-blue-600 underline font-medium hover:text-blue-700">See all reviews on Trustpilot</a>
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        
        <!-- Review 1 -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-3">★★★★★</div>
            <p class="text-slate-700 text-sm italic mb-6">
              "ExpressBoda made our Denmark marriage completely stress-free. They checked every document beforehand, so our application to the Agency of Family Law was approved on the first try without any delays!"
            </p>
          </div>
          <div class="border-t border-slate-100 pt-4 flex items-center justify-between">
            <span class="font-bold text-slate-900 text-sm">Anna & Marco</span>
            <span class="text-xs text-slate-400">Verified Trustpilot Review</span>
          </div>
        </div>

        <!-- Review 2 -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-3">★★★★★</div>
            <p class="text-slate-700 text-sm italic mb-6">
              "Incredible service! From the first consultation to getting our certificate in Denmark, everything took less than a month. Transparent pricing with zero hidden fees. Highly recommend!"
            </p>
          </div>
          <div class="border-t border-slate-100 pt-4 flex items-center justify-between">
            <span class="font-bold text-slate-900 text-sm">David & Sarah</span>
            <span class="text-xs text-slate-400">Verified Trustpilot Review</span>
          </div>
        </div>

        <!-- Review 3 -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-3">★★★★★</div>
            <p class="text-slate-700 text-sm italic mb-6">
              "We tried to figure out the paperwork ourselves and got confused. Handing it over to ExpressBoda was the best decision. Professional, fast, and always in touch on WhatsApp."
            </p>
          </div>
          <div class="border-t border-slate-100 pt-4 flex items-center justify-between">
            <span class="font-bold text-slate-900 text-sm">Elena & Thomas</span>
            <span class="text-xs text-slate-400">Verified Trustpilot Review</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="services" class="bg-slate-50 py-16 px-6 border-t border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">Transparent Pricing Packages</h2>
        <p class="text-slate-600">No hidden fees. Choose the level of support you need.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-xl text-slate-900 mb-2">Standard Package</h3>
            <p class="text-slate-500 text-sm mb-6">Ideal for straightforward cases seeking full professional preparation.</p>
            <ul class="space-y-2 text-sm text-slate-700 mb-8">
              <li>✓ Document verification & audit</li>
              <li>✓ AFL application submission</li>
              <li>✓ Municipality booking support</li>
              <li>✓ Direct supervisor assistance</li>
            </ul>
          </div>
          <a href="/en/services/standard" class="block text-center bg-slate-900 hover:bg-slate-800 text-white py-3 rounded-xl font-medium transition">Select Package</a>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-md border-2 border-blue-600 flex flex-col justify-between relative">
          <div class="absolute -top-3 right-6 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Most Popular</div>
          <div>
            <h3 class="font-bold text-xl text-slate-900 mb-2">Full-Cycle & Apostille</h3>
            <p class="text-slate-500 text-sm mb-6">End-to-end service including legalization for international use.</p>
            <ul class="space-y-2 text-sm text-slate-700 mb-8">
              <li>✓ Everything in Standard Package</li>
              <li>✓ Priority queue processing</li>
              <li>✓ Apostille certification included</li>
              <li>✓ Dedicated manager on WhatsApp</li>
            </ul>
          </div>
          <a href="/en/services/full-cycle" class="block text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-medium transition">Select Package</a>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-xl text-slate-900 mb-2">Express & VIP</h3>
            <p class="text-slate-500 text-sm mb-6">Urgent timelines and customized VIP concierge support.</p>
            <ul class="space-y-2 text-sm text-slate-700 mb-8">
              <li>✓ Accelerated document review</li>
              <li>✓ Customized municipality choice</li>
              <li>✓ VIP witness arrangements</li>
              <li>✓ Full legal backing & guarantees</li>
            </ul>
          </div>
          <a href="/en/services/vip" class="block text-center bg-slate-900 hover:bg-slate-800 text-white py-3 rounded-xl font-medium transition">Select Package</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 px-6 max-w-5xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">How Your Marriage in Denmark Works</h2>
      <p class="text-slate-600">A clear 4-step roadmap from start to your official certificate</p>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">01</div>
        <h4 class="font-bold text-slate-900 mb-1">Free Assessment</h4>
        <p class="text-xs text-slate-600">You send us your documents, we check compliance instantly.</p>
      </div>
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">02</div>
        <h4 class="font-bold text-slate-900 mb-1">AFL Submission</h4>
        <p class="text-xs text-slate-600">We file your application directly to the Danish Agency of Family Law.</p>
      </div>
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">03</div>
        <h4 class="font-bold text-slate-900 mb-1">Choose Date & Place</h4>
        <p class="text-xs text-slate-600">Select your preferred scenic Danish town and wedding date.</p>
      </div>
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="text-blue-600 font-bold text-xl mb-2">04</div>
        <h4 class="font-bold text-slate-900 mb-1">Say "I Do"</h4>
        <p class="text-xs text-slate-600">Travel for 1-2 days, have your ceremony, and get your certificate.</p>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 px-6 border-t border-slate-200">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-3xl font-bold text-slate-900 text-center mb-10">Frequently Asked Questions</h2>
      
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">Is a Danish marriage recognized internationally?</h3>
          <p class="text-slate-600 text-sm">Yes. Marriage certificates issued in Denmark are fully legal and recognized worldwide under international conventions, making them valid for residence permits, spousal visas, and registration in Spain and the EU.</p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">Do we need to live or reside in Denmark?</h3>
          <p class="text-slate-600 text-sm">No residency or citizenship in Denmark is required. International couples from all over the world choose Denmark due to its open, transparent, and fast administrative legal framework.</p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">How long does the entire process take?</h3>
          <p class="text-slate-600 text-sm">Approval from the Agency of Family Law typically takes about 5-7 working days once correct documents are submitted. Ceremonies can usually be scheduled shortly after approval.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>