---
import Layout from '../../layouts/BaseLayout.astro';
import Quiz from '../../components/Quiz.astro';

// Устанавливаем текущий язык страницы
const lang = 'en';
---

<Layout 
  title="ExpressBoda — Legal Marriage in Denmark for International Couples" 
  description="Direct application to the Danish Agency of Family Law (AFL). Guaranteed correct document preparation, full support at all stages, and fast legalization."
  lang={lang}
>
  <!-- ПЛАВАЮЩАЯ КНОПКА WHATSAPP -->
  <a href="https://wa.me/34600000000" class="whatsapp-float" target="_blank" title="Chat on WhatsApp">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="fill:#fff; stroke:none;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
  </a>

  <!-- 1. HERO СЕКЦИЯ С КВИЗОМ -->
  <section class="bg-gradient-to-b from-slate-100 to-[#FAFAFC] py-14 px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid md:grid-cols-12 gap-12 items-start">
      
      <!-- Левая колонка: Заголовок и оффер -->
      <div class="md:col-span-7">
        <div class="inline-flex items-center gap-2 mb-4 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
          <span class="text-[#00B67A] font-bold">★★★★★</span>
          <span class="text-xs font-semibold text-slate-700">5.0 on Trustpilot</span>
        </div>
        
        <h1 class="font-serif text-4xl lg:text-5xl font-bold leading-tight text-slate-900 mb-6">
          Legal Marriage in Denmark for International Couples — Zero Bureaucracy
        </h1>
        
        <p class="text-slate-600 text-base mb-8">
          Direct application to the Danish Agency of Family Law (AFL). Guaranteed correct document preparation, full support at every step, and fast legalization.
        </p>
        
        <div class="flex flex-wrap items-center gap-4">
          <a href="#pricing" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold text-sm transition-colors shadow-sm">Choose Service Package</a>
          <span class="text-sm text-slate-500">⚡ AFL Approval: 5–7 days</span>
        </div>
      </div>

      <!-- Правая колонка: Ваш компонент Quiz -->
      <div class="md:col-span-5">
        <Quiz />
      </div>

    </div>
  </section>

  <!-- 2. СТРИП С МЕТРИКАМИ -->
  <div class="bg-white border-b border-slate-200 py-8">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="font-serif text-3xl font-bold text-slate-900">1,200+</div>
        <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-medium">Registered Couples</div>
      </div>
      <div>
        <div class="font-serif text-3xl font-bold text-slate-900">99.4%</div>
        <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-medium">First-Try AFL Approvals</div>
      </div>
      <div>
        <div class="font-serif text-3xl font-bold text-slate-900">2,300 DKK</div>
        <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-medium">Official Danish Fee</div>
      </div>
      <div>
        <div class="font-serif text-3xl font-bold text-slate-900">100% ★</div>
        <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-medium">Trustpilot Rating</div>
      </div>
    </div>
  </div>

  <!-- 3. СЕКЦИЯ СРАВНЕНИЯ (DIY vs ExpressBoda) -->
  <section class="bg-white border-b border-slate-200 py-16 px-6" id="compare">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-3xl font-bold text-slate-900 text-center mb-3">Why International Couples Choose ExpressBoda</h2>
      <p class="text-slate-500 text-center text-sm mb-12">Compare DIY application risks with professional agency handling</p>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-red-50/50 border border-red-200 p-8 rounded-2xl">
          <h3 class="text-red-900 font-bold text-lg mb-6 flex items-center gap-2">❌ DIY Application</h3>
          <ul class="space-y-4 text-sm text-slate-700">
            <li class="flex gap-3"><b>Risk of rejection:</b> Small translation errors or missing paperwork can stall your case for months.</li>
            <li class="flex gap-3"><b>Loss of 2,300 DKK:</b> The official AFL fee is non-refundable if your application is rejected.</li>
            <li class="flex gap-3"><b>Bureaucratic stress:</b> Dealing with official Danish state correspondence alone.</li>
          </ul>
        </div>

        <div class="bg-emerald-50/50 border border-emerald-200 p-8 rounded-2xl">
          <h3 class="text-emerald-900 font-bold text-lg mb-6 flex items-center gap-2">✅ Through ExpressBoda</h3>
          <ul class="space-y-4 text-sm text-slate-700">
            <li class="flex gap-3"><b>100% pre-audit:</b> We thoroughly verify every scanned document before submission to AFL.</li>
            <li class="flex gap-3"><b>Time saved:</b> Receive your marriage approval rapidly without revisions.</li>
            <li class="flex gap-3"><b>Full cycle:</b> Assistance with translations, Ministry of Foreign Affairs Apostille, and logistics.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. ПАКЕТЫ УСЛУГ И ЦЕНЫ -->
  <section class="max-w-7xl mx-auto py-16 px-6" id="pricing">
    <h2 class="font-serif text-3xl font-bold text-slate-900 text-center mb-3">Transparent Pricing Packages</h2>
    <p class="text-slate-500 text-center text-sm mb-12">No hidden fees. Choose the level of support you need.</p>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white border border-slate-200 rounded-2xl p-8 flex flex-col">
        <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">Essential</h3>
        <div class="text-3xl font-bold text-slate-900 mb-6">€490</div>
        <ul class="space-y-3 text-sm text-slate-600 mb-8 flex-grow">
          <li class="flex items-center gap-2">✓ Full document scan audit</li>
          <li class="flex items-center gap-2">✓ AFL application preparation & submission</li>
          <li class="flex items-center gap-2">✓ Town hall date booking</li>
        </ul>
        <a href="https://wa.me/34600000000" class="bg-slate-100 hover:bg-slate-200 text-slate-900 font-semibold py-3 rounded-xl text-center transition-colors text-sm">Choose Essential</a>
      </div>

      <div class="bg-white border-2 border-blue-600 rounded-2xl p-8 flex flex-col relative shadow-lg">
        <span class="absolute -top-3.5 right-6 bg-blue-600 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">Most Popular</span>
        <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">Premium Care</h3>
        <div class="text-3xl font-bold text-slate-900 mb-6">€790</div>
        <ul class="space-y-3 text-sm text-slate-600 mb-8 flex-grow">
          <li class="flex items-center gap-2">✓ Everything in Essential</li>
          <li class="flex items-center gap-2">✓ Priority AFL review handling</li>
          <li class="flex items-center gap-2">✓ 24/7 personal WhatsApp manager</li>
          <li class="flex items-center gap-2">✓ Ministry Apostille organization</li>
        </ul>
        <a href="https://wa.me/34600000000" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl text-center transition-colors text-sm shadow-sm">Choose Premium</a>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-8 flex flex-col">
        <h3 class="font-serif text-xl font-bold text-slate-900 mb-2">VIP Turnkey</h3>
        <div class="text-3xl font-bold text-slate-900 mb-6">€1,290</div>
        <ul class="space-y-3 text-sm text-slate-600 mb-8 flex-grow">
          <li class="flex items-center gap-2">✓ Everything in Premium Care</li>
          <li class="flex items-center gap-2">✓ Express certificate apostille</li>
          <li class="flex items-center gap-2">✓ Door-to-door courier delivery</li>
          <li class="flex items-center gap-2">✓ Dedicated personal lawyer support</li>
        </ul>
        <a href="https://wa.me/34600000000" class="bg-slate-100 hover:bg-slate-200 text-slate-900 font-semibold py-3 rounded-xl text-center transition-colors text-sm">Choose VIP</a>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="max-w-4xl mx-auto py-16 px-6" id="faq">
    <h2 class="font-serif text-3xl font-bold text-slate-900 text-center mb-3">Frequently Asked Questions</h2>
    <p class="text-slate-500 text-center text-sm mb-12">Everything you need to know about getting married in Denmark</p>

    <div class="space-y-4">
      <details class="bg-white border border-slate-200 rounded-xl overflow-hidden group">
        <summary class="p-6 font-bold text-slate-900 cursor-pointer flex justify-between items-center text-base">
          Why is Denmark the best place for an international marriage in Europe?
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▾</span>
        </summary>
        <div class="px-6 pb-6 text-sm text-slate-600 border-t border-slate-100 pt-4 leading-relaxed">
          Denmark offers streamlined, bureaucracy-free requirements. It does not require a Certificate of Singleness or months of court waiting times, and certificates are issued in 5 languages.
        </div>
      </details>

      <details class="bg-white border border-slate-200 rounded-xl overflow-hidden group">
        <summary class="p-6 font-bold text-slate-900 cursor-pointer flex justify-between items-center text-base">
          What documents are required to apply to the AFL?
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▾</span>
        </summary>
        <div class="px-6 pb-6 text-sm text-slate-600 border-t border-slate-100 pt-4 leading-relaxed">
          Valid passports/IDs, proof of legal stay in the EU (visa or residence permit), and evidence of a genuine relationship.
        </div>
      </details>
    </div>
  </section>
</Layout>