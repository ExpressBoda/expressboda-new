---
// WhatYouNeed.astro (Updated Order & Icons)
const services = [
  {
    title: "Marriage Registration",
    desc: "Fast and official for couples worldwide",
    icon: `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>`,
    link: "#services"
  },
  {
    title: "Expert Consultation",
    desc: "Case review and document check",
    icon: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>`,
    link: "https://wa.me/491754019766"
  },
  {
    title: "Apostille Marriage Certificate",
    desc: "International legalization for recognition",
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>`,
    link: "https://wa.me/491754019766"
  },
  {
    title: "Change Registry Office",
    desc: "Transfer municipality or booking dates",
    icon: `<polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>`,
    link: "https://wa.me/491754019766"
  },
  {
    title: "Duplicate Certificate",
    desc: "Request certified copies from archives",
    icon: `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>`,
    link: "https://wa.me/491754019766"
  }
];
---

<section class="py-16 px-6 max-w-7xl mx-auto">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-4">What Do You Need?</h2>
    <p class="text-slate-600">Select your specific task for fast professional assistance</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
    {services.map(item => (
      <a href={item.link} class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:border-blue-600 hover:shadow-md transition flex flex-col items-center text-center group">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4 group-hover:bg-blue-600 group-hover:text-white transition">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon}></svg>
        </div>
        <h3 class="font-bold text-slate-900 text-base mb-2 group-hover:text-blue-600 transition">{item.title}</h3>
        <p class="text-xs text-slate-600 leading-relaxed">{item.desc}</p>
      </a>
    ))}
  </div>
</section>