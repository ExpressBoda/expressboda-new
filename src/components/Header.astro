---
import { useTranslations, languages, type Lang } from '../i18n/utils';
import { getAlternateLinks } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = getAlternateLinks(Astro.url);
---

<header class="border-b border-gray-100">
  <div class="max-w-6xl mx-auto flex items-center justify-between px-4 py-4">
    <a href={`/${lang}/`} class="font-serif text-xl">ExpressBoda</a>
    <nav class="hidden md:flex gap-6 text-sm">
      <a href={`/${lang}/services/`}>{t('nav.services')}</a>
      <a href={`/${lang}/guide/`}>{t('nav.guide')}</a>
      <a href={`/${lang}/pricing/`}>{t('nav.pricing')}</a>
      <a href={`/${lang}/about/`}>{t('nav.about')}</a>
      <a href={`/${lang}/contact/`}>{t('nav.contact')}</a>
    </nav>
    {/* Переключатель языка — ведёт на ту же страницу на другом языке, не на главную */}
    <div class="flex gap-2 text-sm">
      {alternates.map((alt) => (
        <a href={alt.href} class={alt.lang === lang ? 'font-bold' : 'text-gray-400'}>
          {alt.lang.toUpperCase()}
        </a>
      ))}
    </div>
  </div>
</header>
