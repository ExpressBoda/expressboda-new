      <!-- Главная кнопка действия -->
      <a href="/#checker" class="btn-primary">Check chances</a>

      <!-- Контакты для мобильного меню -->
      <div class="mobile-contacts">
        <a href="tel:+491744019766">📞 +49 174 4019766</a>
        <a href="tel:+34611592877">📞 +34 611 592877</a>
        <a href="mailto:info@expressboda.com">✉️ info@expressboda.com</a>
      </div>
    </nav>
