<!-- Нижняя липкая панель для мобильных -->
<div class="mobile-sticky-footer">
  <div class="sticky-footer-content">
    <div class="sticky-footer-text">
      <span class="sticky-title">Plan your wedding in Denmark</span>
      <span class="sticky-subtitle">Fast & official registration</span>
    </div>
    <a href="#express-boda-quiz" class="sticky-cta-btn">
      Check chances
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>
</div>

<style>
  :root {
    --primary: #0F172A;
    --accent: #0B53FB;
    --accent-hover: #003ECC;
    --border: #E2E8F0;
    --text-main: #334155;
    --text-muted: #64748B;
    --whatsapp: #10B981;
    --whatsapp-bg: #ECFDF5;
  }

  /* Шапка прилипает целиком на десктопе */
  .site-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }

  .top-bar { 
    background: #0F172A; 
    color: #CBD5E1; 
    font-size: 13px; 
    border-bottom: 1px solid #1E293B; 
  }
  
  .top-bar-container, .header-container { 
    max-width: 1200px; 
    margin: 0 auto; 
    padding: 12px 24px; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    width: 100%; 
  }

  .top-bar-container {
    padding-top: 8px;
    padding-bottom: 8px;
  }
  
  .lang-switcher { display: flex; gap: 12px; }
  .lang-switcher a { color: #94A3B8; text-decoration: none; font-weight: 600; text-transform: uppercase; transition: color 0.2s; }
  .lang-switcher a.active, .lang-switcher a:hover { color: #FFF; }

  .top-bar-right { display: flex; align-items: center; gap: 14px; }
  .top-bar-phones { display: flex; gap: 8px; align-items: center; }
  .top-bar-phones a { color: #F8FAFC; text-decoration: none; font-weight: 600; font-size: 13px; transition: color 0.2s; }
  .top-bar-phones a:hover { color: var(--accent); }
  .top-bar-email { color: #CBD5E1; text-decoration: none; transition: color 0.2s; }
  .top-bar-email:hover { color: #FFF; }
  .phone-divider { color: #475569; }

  header { 
    background: #ffffff; 
    border-bottom: 1px solid var(--border); 
    box-shadow: 0 2px 8px rgba(0,0,0,0.03); 
    width: 100%; 
  }
  
  .logo-mobile { display: none; }
  .logo-desktop { display: flex; align-items: flex-start; gap: 0px; }

  .logo { 
    font-family: 'Montserrat', 'Inter', system-ui, -apple-system, sans-serif; 
    font-size: 26px; 
    font-weight: 800; 
    color: var(--primary); 
    text-decoration: none; 
    letter-spacing: -0.5px; 
    transition: opacity 0.2s;
    line-height: 1;
  }
  .logo:hover { opacity: 0.9; }
  .logo-icon { 
    color: var(--accent); 
    width: 17px; 
    height: 17px; 
    position: relative;
    top: -2px; 
    flex-shrink: 0; 
  }
  
  nav { display: flex; gap: 16px; align-items: center; }
  nav a.nav-link { text-decoration: none; color: var(--text-main); font-size: 14px; font-weight: 500; transition: color 0.2s; }
  nav a.nav-link:hover { color: var(--accent); }
  
  .btn-primary { background: var(--accent); color: #fff; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; transition: background 0.2s; border: none; cursor: pointer; display: inline-block; text-align: center; }
  .btn-primary:hover { background: var(--accent-hover); }

  .btn-whatsapp-header { background: var(--whatsapp-bg); color: var(--whatsapp); border: 1px solid rgba(16, 185, 129, 0.3); padding: 9px 14px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 6px; transition: all 0.2s; }
  .btn-whatsapp-header:hover { background: var(--whatsapp); color: #fff; border-color: var(--whatsapp); }

  .mobile-header-whatsapp { display: none; }
  .mobile-lang-switcher, .mobile-contacts { display: none; }
  .mobile-sticky-footer { display: none; }

  .menu-toggle { display: none; background: none; border: none; cursor: pointer; width: 30px; height: 24px; position: relative; padding: 0; z-index: 101; }
  .menu-toggle span { display: block; position: absolute; height: 3px; width: 100%; background: var(--primary); border-radius: 2px; opacity: 1; left: 0; transition: 0.25s ease-in-out; }
  .menu-toggle span:nth-child(1) { top: 0px; }
  .menu-toggle span:nth-child(2) { top: 10px; }
  .menu-toggle span:nth-child(3) { top: 20px; }

  .menu-toggle.active span:nth-child(1) { top: 10px; transform: rotate(135deg); }
  .menu-toggle.active span:nth-child(2) { opacity: 0; transform: translateX(-10px); }
  .menu-toggle.active span:nth-child(3) { top: 10px; transform: rotate(-135deg); }

  @media (max-width: 1024px) {
    .top-bar { display: none; }
    
    .logo-desktop { display: none; }
    .logo-mobile { 
      display: inline-block;
      font-weight: 800;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--primary);
    }
    .logo-boda {
      color: var(--accent); /* Синий цвет для Boda */
    }

    .header-container { 
      display: grid;
      grid-template-columns: 36px 1fr 30px;
      align-items: center;
      padding: 14px 20px; 
    }
    
    .mobile-header-whatsapp {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--whatsapp);
      background: var(--whatsapp-bg);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      justify-self: start;
    }

    .logo { 
      justify-self: center; 
      text-align: center;
    }

    .menu-toggle { 
      display: block; 
      justify-self: end; 
    }

    nav { 
      display: none; 
      position: absolute; 
      top: 100%; 
      left: 0; 
      width: 100%; 
      background: #ffffff; 
      flex-direction: column; 
      align-items: stretch; 
      padding: 20px 24px; 
      border-bottom: 1px solid var(--border); 
      box-shadow: 0 10px 20px rgba(0,0,0,0.08);
      gap: 16px;
      max-height: 80vh;
      overflow-y: auto;
    }
    nav.active { display: flex; }

    .mobile-lang-switcher { display: flex; flex-direction: column; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid #F1F5F9; }
    .lang-title { font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.5px; }
    .lang-options { display: flex; gap: 8px; }
    .lang-pill { flex: 1; text-align: center; padding: 8px; font-size: 13px; font-weight: 600; text-decoration: none; color: var(--text-main); background: #F1F5F9; border-radius: 6px; border: 1px solid var(--border); }
    .lang-pill.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    nav a.nav-link { font-size: 16px; padding: 4px 0; border-bottom: 1px solid #F8FAFC; }
    
    .btn-whatsapp-header { justify-content: center; padding: 11px; }

    .mobile-contacts {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-top: 14px;
      margin-top: 4px;
      border-top: 1px solid #F1F5F9;
      font-size: 14px;
      font-weight: 600;
    }
    .mobile-contacts a {
      color: var(--text-main);
      text-decoration: none;
    }

    /* Мобильный липкий футер внизу */
    .mobile-sticky-footer {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: #ffffff;
      border-top: 1px solid var(--border);
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
      z-index: 99;
      padding: 10px 16px;
      animation: slideUp 0.3s ease-out;
    }

    .sticky-footer-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      max-width: 600px;
      margin: 0 auto;
    }

    .sticky-footer-text {
      display: flex;
      flex-direction: column;
    }

    .sticky-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--primary);
      line-height: 1.2;
    }

    .sticky-subtitle {
      font-size: 11px;
      color: var(--text-muted);
    }

    .sticky-cta-btn {
      background: var(--accent);
      color: #fff;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: background 0.2s;
    }

    .sticky-cta-btn:hover {
      background: var(--accent-hover);
    }
  }

  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');

  menuToggle?.addEventListener('click', () => {
    navMenu?.classList.toggle('active');
    menuToggle?.classList.toggle('active');
  });

  document.querySelectorAll('#navMenu a').forEach(link => {
    link.addEventListener('click', () => {
      navMenu?.classList.remove('active');
      menuToggle?.classList.remove('active');
    });
  });
</script>