</header>

<style>
  :root {
    --primary: #0F172A;
    --accent: #0B53FB;
    --accent-hover: #003ECC;
    --border: #E2E8F0;
    --text-main: #334155;
    --text-muted: #64748B;
    --whatsapp: #10B981;
    --whatsapp-bg: #ECFDF5;
  }

  /* Строго одинаковые контейнеры с одинаковыми отступы по бокам (24px) */
  .top-bar { background: #0F172A; color: #CBD5E1; font-size: 13px; padding: 8px 24px; border-bottom: 1px solid #1E293B; }
  .top-bar-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; width: 100%; }
  
  .lang-switcher { display: flex; gap: 12px; }
  .lang-switcher a { color: #94A3B8; text-decoration: none; font-weight: 600; text-transform: uppercase; transition: color 0.2s; }
  .lang-switcher a.active, .lang-switcher a:hover { color: #FFF; }

  .top-bar-right { display: flex; align-items: center; gap: 14px; }
  .top-bar-phones { display: flex; gap: 8px; align-items: center; }
  .top-bar-phones a { color: #F8FAFC; text-decoration: none; font-weight: 600; font-size: 13px; transition: color 0.2s; }
  .top-bar-phones a:hover { color: var(--accent); }
  .top-bar-email { color: #CBD5E1; text-decoration: none; transition: color 0.2s; }
  .top-bar-email:hover { color: #FFF; }
  .phone-divider { color: #475569; }

  header { background: #ffffff; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 8px rgba(0,0,0,0.03); }
  
  /* Основной контейнер шапки теперь имеет те же max-width: 1200px и padding: 0 24px, что и верхний бар */
  .header-container { max-width: 1200px; margin: 0 auto; padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; width: 100%; }
  
  .logo { font-family: 'Playfair Display', serif; font-size: 24px; text-decoration: none; letter-spacing: -0.5px; display: flex; align-items: center; gap: 8px; }
  .logo-globe { color: var(--accent); width: 22px; height: 22px; flex-shrink: 0; }
  .logo-express { font-weight: 800; color: var(--primary); }
  .logo-boda { font-weight: 300; color: var(--accent); margin-left: -1px; }
  
  nav { display: flex; gap: 16px; align-items: center; }
  nav a.nav-link { text-decoration: none; color: var(--text-main); font-size: 14px; font-weight: 500; transition: color 0.2s; }
  nav a.nav-link:hover { color: var(--accent); }
  
  .btn-primary { background: var(--accent); color: #fff; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; transition: background 0.2s; border: none; cursor: pointer; display: inline-block; text-align: center; }
  .btn-primary:hover { background: var(--accent-hover); }

  .btn-whatsapp-header { background: var(--whatsapp-bg); color: var(--whatsapp); border: 1px solid rgba(16, 185, 129, 0.3); padding: 9px 14px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 6px; transition: all 0.2s; }
  .btn-whatsapp-header:hover { background: var(--whatsapp); color: #fff; border-color: var(--whatsapp); }

  .menu-toggle { display: none; background: none; border: none; cursor: pointer; width: 30px; height: 24px; position: relative; padding: 0; z-index: 101; }
  .menu-toggle span { display: block; position: absolute; height: 3px; width: 100%; background: var(--primary); border-radius: 2px; opacity: 1; left: 0; transition: 0.25s ease-in-out; }
  .menu-toggle span:nth-child(1) { top: 0px; }
  .menu-toggle span:nth-child(2) { top: 10px; }
  .menu-toggle span:nth-child(3) { top: 20px; }

  .menu-toggle.active span:nth-child(1) { top: 10px; transform: rotate(135deg); }
  .menu-toggle.active span:nth-child(2) { opacity: 0; transform: translateX(-10px); }
  .menu-toggle.active span:nth-child(3) { top: 10px; transform: rotate(-135deg); }

  .mobile-lang-switcher, .mobile-contacts { display: none; }

  @media (max-width: 1024px) {
    .top-bar { display: none; }
    .menu-toggle { display: block; }
    nav { 
      display: none; 
      position: absolute; 
      top: 100%; 
      left: 0; 
      width: 100%; 
      background: #ffffff; 
      flex-direction: column; 
      align-items: stretch; 
      padding: 20px 24px; 
      border-bottom: 1px solid var(--border); 
      box-shadow: 0 10px 20px rgba(0,0,0,0.08);
      gap: 16px;
      max-height: 80vh;
      overflow-y: auto;
    }
    nav.active { display: flex; }

    .mobile-lang-switcher { display: flex; flex-direction: column; gap: 8px; padding-bottom: 12px; border-bottom: 1px실 solid #F1F5F9; }
    .lang-title { font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.5px; }
    .lang-options { display: flex; gap: 8px; }
    .lang-pill { flex: 1; text-align: center; padding: 8px; font-size: 13px; font-weight: 600; text-decoration: none; color: var(--text-main); background: #F1F5F9; border-radius: 6px; border: 1px solid var(--border); }
    .lang-pill.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    nav a.nav-link { font-size: 16px; padding: 4px 0; border-bottom: 1px solid #F8FAFC; }
    
    .btn-whatsapp-header { justify-content: center; padding: 11px; }

    .mobile-contacts {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-top: 14px;
      margin-top: 4px;
      border-top: 1px solid #F1F5F9;
      font-size: 14px;
      font-weight: 600;
    }
    .mobile-contacts a {
      color: var(--text-main);
      text-decoration: none;
      transition: color 0.2s;
    }
    .mobile-contacts a:hover {
      color: var(--accent);
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');

  menuToggle?.addEventListener('click', () => {
    navMenu?.classList.toggle('active');
    menuToggle?.classList.toggle('active');
  });

  document.querySelectorAll('#navMenu a').forEach(link => {
    link.addEventListener('click', () => {
      navMenu?.classList.remove('active');
      menuToggle?.classList.remove('active');
    });
  });
</script>