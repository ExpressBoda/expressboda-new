---
import { useTranslations, type Lang } from '../i18n/utils';
import { getAlternateLinks } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = getAlternateLinks(Astro.url);
---

<header class="border-b border-gray-100 bg-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4">
    <a href={`/${lang}/`} class="font-serif text-xl font-bold text-slate-900">ExpressBoda</a>
    
    <nav class="hidden md:flex gap-6 text-sm text-slate-600">
      <a href={`/${lang}/services/`} class="hover:text-slate-900 transition-colors">{t('nav.services')}</a>
      <a href={`/${lang}/guide/`} class="hover:text-slate-900 transition-colors">{t('nav.guide')}</a>
      <a href={`/${lang}/pricing/`} class="hover:text-slate-900 transition-colors">{t('nav.pricing')}</a>
      <a href={`/${lang}/about/`} class="hover:text-slate-900 transition-colors">{t('nav.about')}</a>
      <a href={`/${lang}/contact/`} class="hover:text-slate-900 transition-colors">{t('nav.contact')}</a>
    </nav>

    <div class="flex gap-2 text-sm">
      {alternates.map((alt) => (
        <a 
          href={alt.href} 
          class={`px-2 py-1 rounded transition-colors ${alt.lang === lang ? 'bg-slate-100 font-bold text-slate-900' : 'text-slate-400 hover:text-slate-600'}`}
        >
          {alt.lang.toUpperCase()}
        </a>
      ))}
    </div>
  </div>
</header>