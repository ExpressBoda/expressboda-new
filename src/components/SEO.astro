---
// Единый SEO-компонент — подключается на каждой странице.
// Гарантирует, что ни одна страница не уйдёт в продакшн без title/description/canonical.
import { getAlternateLinks, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  noindex?: boolean;
}

const { title, description, lang, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternates = getAlternateLinks(Astro.url);
---

<title>{title} | ExpressBoda</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

{/* hreflang — критично для мультиязычного сайта, чтобы Google не считал версии дублями */}
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, Astro.site)} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(`/en/`, Astro.site)} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={lang} />
<meta name="twitter:card" content="summary" />
