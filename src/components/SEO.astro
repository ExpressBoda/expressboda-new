---
// Единый SEO-компонент — подключается на каждой странице.
import { getAlternateLinks, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  noindex?: boolean;
  alternateLanguages?: Lang[];
}

const { title, description, lang, noindex = false, alternateLanguages } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternates = getAlternateLinks(Astro.url).filter((alternate) =>
  alternateLanguages === undefined || alternateLanguages.includes(alternate.lang),
);
---

<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<title>{title} | ExpressBoda</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex,follow" />}

{/* hreflang — критично для мультиязычного сайта, чтобы Google не считал версии дублями */}
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, Astro.site)} />
))}
{alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(`/en/${Astro.url.pathname.split('/').slice(2).filter(Boolean).join('/')}/`, Astro.site)} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={lang} />
<meta name="twitter:card" content="summary" />
