---
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const prefix = `/${lang}`;
const copy = {
  en: { overview: 'Information for couples planning a wedding in Denmark.', explore: 'Explore', support: 'Support', legal: 'Legal', contact: 'Contact', guides: 'Guides', apostille: 'Apostille & Legalisation', privacy: 'Privacy Policy', terms: 'Terms', application: 'Start Your Application', requirements: 'Requirements', gettingMarried: 'Getting Married in Denmark' },
  de: { overview: 'Informationen für Paare, die eine Hochzeit in Dänemark planen.', explore: 'Entdecken', support: 'Unterstützung', legal: 'Rechtliches', contact: 'Kontakt', guides: 'Ratgeber', apostille: 'Apostille & Legalisation', privacy: 'Datenschutz', terms: 'Bedingungen', application: 'Antrag starten', requirements: 'Voraussetzungen', gettingMarried: 'Heiraten in Dänemark' },
  es: { overview: 'Información para parejas que planean casarse en Dinamarca.', explore: 'Explorar', support: 'Ayuda', legal: 'Legal', contact: 'Contacto', guides: 'Guías', apostille: 'Apostilla y legalización', privacy: 'Política de privacidad', terms: 'Términos', application: 'Iniciar solicitud', requirements: 'Requisitos', gettingMarried: 'Casarse en Dinamarca' },
  ru: { overview: 'Информация для пар, планирующих брак в Дании.', explore: 'Разделы', support: 'Поддержка', legal: 'Правовая информация', contact: 'Контакты', guides: 'Гиды', apostille: 'Апостиль и легализация', privacy: 'Конфиденциальность', terms: 'Условия', application: 'Начать заявку', requirements: 'Требования', gettingMarried: 'Брак в Дании' },
}[lang];
---

<footer class="bg-slate-900 px-6 py-12 text-slate-400 border-t border-slate-800">
  <div class="mx-auto mb-8 grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-4">
    <div><div class="mb-3 font-serif text-lg font-bold text-white">ExpressBoda</div><p class="text-xs leading-relaxed">{copy.overview}</p></div>
    <div><div class="mb-3 text-sm font-semibold text-white">{copy.explore}</div><ul class="space-y-2 text-xs"><li><a href={`${prefix}/getting-married-in-denmark/`} class="transition-colors hover:text-white">{copy.gettingMarried}</a></li><li><a href={`${prefix}/guides/`} class="transition-colors hover:text-white">{copy.guides}</a></li><li><a href={`${prefix}/apostille-legalisation/`} class="transition-colors hover:text-white">{copy.apostille}</a></li></ul></div>
    <div><div class="mb-3 text-sm font-semibold text-white">{copy.support}</div><ul class="space-y-2 text-xs"><li><a href={`${prefix}/requirements/`} class="transition-colors hover:text-white">{copy.requirements}</a></li><li><a href={`${prefix}/faq/`} class="transition-colors hover:text-white">FAQ</a></li><li><a href={`${prefix}/contact/`} class="transition-colors hover:text-white">{copy.contact}</a></li></ul></div>
    <div><div class="mb-3 text-sm font-semibold text-white">{copy.legal}</div><ul class="space-y-2 text-xs"><li><a href={`${prefix}/privacy/`} class="transition-colors hover:text-white">{copy.privacy}</a></li><li><a href={`${prefix}/terms/`} class="transition-colors hover:text-white">{copy.terms}</a></li><li><a href={`${prefix}/start-your-application/`} class="font-semibold text-white transition-colors hover:text-blue-300">{copy.application}</a></li></ul></div>
  </div>
  <div class="mx-auto max-w-7xl border-t border-slate-800 pt-8 text-center text-xs text-slate-500">© {new Date().getFullYear()} ExpressBoda. All rights reserved.</div>
</footer>
